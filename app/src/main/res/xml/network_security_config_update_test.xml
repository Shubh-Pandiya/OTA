<?xml version="1.0" encoding="utf-8"?>
<!-- Only for the emulator update test (built with OTA_UPDATE_FEED=http://10.0.2.2:… or http://127.0.0.1:… via adb reverse):
     the host's test release server, and user-installed CAs so test release builds also work behind
     a TLS-inspecting proxy. Real builds always use network_security_config.xml. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
