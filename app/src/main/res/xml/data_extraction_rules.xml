<?xml version="1.0" encoding="utf-8"?>
<!-- Cloud sign-in tokens and sync cursors stay on this device: never backed up or transferred.
     The databases and advice images are encrypted with a key that never leaves this phone's
     Keystore, so a copy would be unreadable elsewhere: they are not backed up either. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="ota_cloud.xml" />
        <exclude domain="sharedpref" path="ota_secure.xml" />
        <exclude domain="database" path="." />
        <exclude domain="file" path="advice_images" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="ota_cloud.xml" />
        <exclude domain="sharedpref" path="ota_secure.xml" />
        <exclude domain="database" path="." />
        <exclude domain="file" path="advice_images" />
    </device-transfer>
</data-extraction-rules>
